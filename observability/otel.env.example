# =============================================================================
# Starlight Agentic OS — OpenTelemetry env for the agent fleet
# -----------------------------------------------------------------------------
# Copy to `.env` (for the compose stack) and/or source per-CLI shells. NO SECRETS
# COMMITTED — fill the ${...:-} / <PLACEHOLDER> values locally.
#
#   cp otel.env.example .env        # edit, then: docker compose --env-file .env ...
#   set -a; . ./otel.env.example; set +a   # export into a shell for a CLI run
#
# DEFAULT SINK = Phoenix (no Docker): pip install arize-phoenix && phoenix serve.
# The OTLP endpoint below already points at Phoenix (localhost:6006). The Langfuse
# block is ONLY for the optional heavy Docker tier — ignore it unless you run compose.
# =============================================================================

# ============ OPTIONAL heavy tier only (Langfuse/Docker) — skip for Phoenix ==
# Secrets — generate each with:  openssl rand -hex 32
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_postgres
POSTGRES_DB=langfuse
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=CHANGE_ME_clickhouse
REDIS_PASSWORD=CHANGE_ME_redis
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGE_ME_minio
LANGFUSE_S3_BUCKET=langfuse
LANGFUSE_S3_REGION=us-east-1

LANGFUSE_SALT=CHANGE_ME_openssl_rand_hex_32
LANGFUSE_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32
LANGFUSE_NEXTAUTH_SECRET=CHANGE_ME_openssl_rand_hex_32
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
LANGFUSE_PORT=3000
LANGFUSE_TELEMETRY_ENABLED=false   # phone-home to Langfuse Inc — keep false for sovereign

# Optional headless bootstrap of a first project + API keys (else create in UI):
LANGFUSE_INIT_ORG_ID=starlight
LANGFUSE_INIT_PROJECT_ID=acos
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-CHANGE_ME
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-CHANGE_ME

# =========================================================================
# 1) NATIVE CLAUDE CODE OTEL  (docs: CLAUDE_CODE_ENABLE_TELEMETRY)
#    Claude Code emits OTel metrics + events for tool decisions, results,
#    permissions, token cost, etc. Points at Phoenix (:6006) by default; a local
#    collector or Langfuse are options below (see INSTRUMENTATION.md).
# =========================================================================
CLAUDE_CODE_ENABLE_TELEMETRY=1

# Exporters: what Claude Code ships. Use otlp for both.
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
# (Claude Code focuses on metrics + events/logs; traces come from OpenLLMetry, below.)

# OTLP transport. Phoenix + Langfuse both speak HTTP/protobuf.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# ---- Option A (DEFAULT): send to local Phoenix — no Docker, no auth --------
# `phoenix serve` listens on :6006 (HTTP OTLP) and :4317 (gRPC). No auth header.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006
OTEL_EXPORTER_OTLP_HEADERS=

# ---- Option B: local OpenTelemetry Collector (fan-in many CLIs) -----------
# Uncomment to route every CLI + app through one collector that forwards to your
# sink(s). Keeps credentials in the collector, not shells.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=

# ---- Option C: heavy tier — send DIRECTLY to Langfuse (Docker) ------------
# Uncomment to target Langfuse instead of Phoenix. Endpoint = <host>/api/public/otel.
# Basic auth = base64("pk-lf-...:sk-lf-..."):  echo -n "pk-lf-...:sk-lf-..." | base64
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:3000/api/public/otel
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<BASE64_PK_COLON_SK>

# Export cadence (short intervals help during dev; raise in prod to cut volume).
OTEL_METRIC_EXPORT_INTERVAL=10000        # ms
OTEL_LOGS_EXPORT_INTERVAL=5000           # ms

# =========================================================================
# 2) SERVICE IDENTITY  (service.name conventions per CLI / agent)
#    resource attributes let you slice traces by which runtime + agent produced
#    them. Set OTEL_SERVICE_NAME per process; add stable resource attrs for the
#    fleet. Convention: starlight.<cli>.<agent-or-pack>.
# =========================================================================
# Per-CLI service names (export the one matching the process you launch):
#   Claude Code : OTEL_SERVICE_NAME=starlight.claude-code
#   Codex       : OTEL_SERVICE_NAME=starlight.codex
#   Gemini      : OTEL_SERVICE_NAME=starlight.gemini
#   Grok        : OTEL_SERVICE_NAME=starlight.grok
OTEL_SERVICE_NAME=starlight.claude-code

# Fleet-wide resource attributes (deployment.environment, the pack in play, owner).
OTEL_RESOURCE_ATTRIBUTES=service.namespace=starlight,deployment.environment=local,service.version=1.0.0,starlight.pack=acos-meta,enduser.id=frank

# =========================================================================
# 3) OpenLLMetry (traceloop SDK)  — instruments the Python/agent CODE
#    Same OTLP endpoint; OpenLLMetry auto-instruments LLM/agent frameworks and
#    nests agent spans inside your app trace. See INSTRUMENTATION.md.
# =========================================================================
TRACELOOP_BASE_URL=http://localhost:6006/v1/traces         # Phoenix (default). Langfuse: http://localhost:3000/api/public/otel
TRACELOOP_HEADERS=                                          # none for local Phoenix; Langfuse: Authorization=Basic%20<BASE64_PK_COLON_SK>
TRACELOOP_TELEMETRY=false                # disable traceloop's own phone-home
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:6006/v1/traces   # Phoenix (default)
